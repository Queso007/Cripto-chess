# Crypto Chess — payout service environment template.
# Copy to .env for local runs. On Render, set each variable in the
# dashboard (Environment > Environment Variables) instead.
# NEVER put real keys or seeds in this file or commit a filled-in .env.

# --- Server ---
PORT=3000
HOST=0.0.0.0
# Where game records live. On Render with a disk attached, set /var/data.
DATA_DIR=./data
# Origin allowed to call the API (the static site URL once deployed).
CORS_ORIGIN=*
# Deposit window in seconds (default 600). Both stakes must land in
# escrow within this window or the game cancels and refunds.
DEPOSIT_TIMEOUT_SEC=600

# --- Operator API token (REQUIRED) ---
# Long random string. The game client must send it as the
# X-Operator-Token header on /result, /cancel, /retry-payout.
# While unset, operator endpoints refuse all calls.
OPERATOR_API_TOKEN=

# --- Operator signing keys (REQUIRED for real payouts) ---
# Set these in the Render dashboard ONLY. Never paste them in chat,
# code, docs, or screenshots. If a key is missing, payouts on that
# chain fail with a clear error naming the variable.
# Tron: hex private key.
OPERATOR_KEY_TRON=
# Solana: base58 secret key (Phantom-style export) or JSON array.
OPERATOR_KEY_SOLANA=
# EVM: 0x hex private key (shared by Ethereum + Polygon).
OPERATOR_KEY_EVM=
# XRPL: family seed (s...).
OPERATOR_KEY_XRPL=

# --- Escrow / operator addresses (defaults are already in config.js) ---
# Override only if an address ever changes. These are PUBLIC addresses.
# ESCROW_TRON=TBgET9wfANqaUFbA1PMGuok2NmRMVVRsoz
# ESCROW_SOLANA=6h9vjU9RjsKGFMAE4y1PYSirytRc4oZJ3YZc5cgJ1KQm
# ESCROW_ETHEREUM=0xA527Dbf12329D45E4E296d75C1983bA23AAf5570
# ESCROW_POLYGON=0xA527Dbf12329D45E4E296d75C1983bA23AAf5570
# ESCROW_XRPL=rPJYyWys3Q3DhR2bTZf8NhzmfVFPoizMRn
# OPERATOR_TRON=TGrGfLCtsuwjGyL5ooivNpqjbBpZDC4s34
# OPERATOR_SOLANA=7wquMQLyAE3bmPiJS4hznZmSYn6f9USRqSdLfn1ZTxkH
# OPERATOR_ETHEREUM=0x76ae8ee24a9D053439530F83bd152ed50b677Beb
# OPERATOR_POLYGON=0x76ae8ee24a9D053439530F83bd152ed50b677Beb
# OPERATOR_XRPL=rn4ZbrXPMCEPrufA6QLGsBfwu7nsw3PmUm

# --- RPC endpoints (public defaults in config.js — no key needed) ---
# Override with a dedicated provider for production volume/rate limits.
# TRONGRID_API_KEY=            # optional; higher TronGrid limits
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ETHEREUM_RPC_URL=https://ethereum.publicnode.com
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# XRPL_WS_URL=wss://xrplcluster.com
# XRPL_JSON_RPC=https://xrplcluster.com

# --- Watcher poll intervals (ms) ---
# POLL_TRON_MS=15000
# POLL_SOLANA_MS=15000
# POLL_EVM_MS=15000
# POLL_XRPL_MS=30000
# SWEEP_MS=30000

# --- Preflight / testing ---
# DRY_RUN=true makes the signer return payloads without submitting
# anything or touching keys. Use it for the first deploy check.
# DRY_RUN=true
